# ─── Application ─────────────────────────────────────────────────
# Runtime mode: development | production | test
NODE_ENV=development

# Port the API listens on
PORT=3000

# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
#   docker-compose: postgresql://postly:postly@postgres:5432/postly?schema=public
#   local dev:      postgresql://postly:postly@localhost:5432/postly?schema=public
DATABASE_URL=postgresql://postly:postly@localhost:5432/postly?schema=public

# ─── Redis ───────────────────────────────────────────────────────
# Redis connection string. Used for sessions, rate limiting, and the
# BullMQ job queue (wired up in later PRs).
#   docker-compose: redis://redis:6379
#   local dev:      redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────
# Secret used to sign JWT access tokens. Use a long, random value
# (e.g. `openssl rand -base64 48`) in any non-local environment.
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (any zeit/ms string supported by jsonwebtoken).
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime, in days.
JWT_REFRESH_EXPIRES_IN_DAYS=7

# bcrypt salt rounds for password hashing. Minimum 12.
BCRYPT_SALT_ROUNDS=12

# ─── Rate Limiting ───────────────────────────────────────────────
# Per-user (or per-IP for unauthenticated) request budget per window.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ─── AI Providers (system fallback keys) ─────────────────────────
# System-wide OpenAI key. Optional — used only when a user has not
# supplied their own key in `ai_keys`.
OPENAI_API_KEY=

# System-wide Anthropic key. Optional — used only when a user has not
# supplied their own key in `ai_keys`.
ANTHROPIC_API_KEY=

# ─── Encryption ──────────────────────────────────────────────────
# 32-byte key for AES-256-GCM encryption. Must be exactly 64 hex
# characters (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── OAuth ────────────────────────────────────────────────────────
# Twitter OAuth 2.0 credentials
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/api/oauth/twitter/callback

# LinkedIn OAuth 2.0 credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/linkedin/callback

# ─── Telegram Bot (optional) ─────────────────────────────────────────────────
# Leave blank to disable the bot feature entirely.
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Secret sent in X-Telegram-Bot-Api-Secret-Token to authenticate webhook calls.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
