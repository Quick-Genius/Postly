# ─── Application ─────────────────────────────────────────────────
# Runtime mode: development | production | test
NODE_ENV=production

# Port the API listens on (Railway injects this automatically)
PORT=3000

# Public HTTPS URL of this deployment. No trailing slash.
# Used for webhook registration and Twilio signature validation.
# Examples:
#   Railway: https://postly-production.up.railway.app
#   Custom:  https://api.postly.dev
BASE_URL=https://your-app.up.railway.app

# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
# Railway provides this automatically when a Postgres plugin is attached.
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# ─── Redis ───────────────────────────────────────────────────────
# Redis connection string. Used for sessions, rate limiting, and the BullMQ queue.
# Railway provides this automatically when a Redis plugin is attached.
REDIS_URL=redis://default:password@host:6379

# ─── Auth ────────────────────────────────────────────────────────
# Secret used to sign JWT access tokens.
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (any zeit/ms string supported by jsonwebtoken).
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime, in days.
JWT_REFRESH_EXPIRES_IN_DAYS=7

# bcrypt salt rounds for password hashing. Minimum 12.
BCRYPT_SALT_ROUNDS=12

# ─── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ─── Encryption ──────────────────────────────────────────────────
# 32-byte key for AES-256-GCM encryption of stored OAuth tokens.
# Must be exactly 64 hex characters (32 bytes).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── AI Providers ────────────────────────────────────────────────
# System-wide fallback keys. Users may also supply their own via the API.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── OAuth ────────────────────────────────────────────────────────
# Twitter OAuth 2.0 credentials (register at developer.twitter.com)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn OAuth 2.0 credentials (register at developer.linkedin.com)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── Telegram Bot ────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram — it gives you the token.
# Leave blank to disable the Telegram bot entirely.
TELEGRAM_BOT_TOKEN=

# Secret forwarded in X-Telegram-Bot-Api-Secret-Token header to protect
# the webhook endpoint from unauthenticated requests.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ─── Twilio / WhatsApp Bot ────────────────────────────────────────
# All three values are required for the WhatsApp bot to work.
# Find them in the Twilio console: console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 format with whatsapp: prefix, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=
